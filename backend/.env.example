# ---------------------------------------------------------------------------
# Configuration de l'IA
# ---------------------------------------------------------------------------
# Laisse AI_PROVIDER=none pour faire tourner le prototype SANS aucune clé API :
# le moteur de règles prend le relais et tout fonctionne normalement.
#
# Pour brancher une vraie IA, remplace "none" par l'un de ces fournisseurs :
#
#   groq        → GRATUIT, sans carte bancaire, très rapide  (recommandé)
#                 Clé : https://console.groq.com/keys
#                 Modèles : llama-3.3-70b-versatile | llama-3.1-8b-instant
#
#   gemini      → GRATUIT, sans carte bancaire (Google AI Studio)
#                 Clé : https://aistudio.google.com/apikey
#                 Modèles : gemini-2.5-flash
#
#   openrouter  → offre gratuite disponible
#                 Clé : https://openrouter.ai/keys
#                 Modèles : meta-llama/llama-3.3-70b-instruct:free
#
#   openai      → payant  |  anthropic → payant
#
# ---------------------------------------------------------------------------

AI_PROVIDER=none
AI_API_KEY=
# Laisse AI_MODEL vide pour utiliser le modèle par défaut du fournisseur choisi
AI_MODEL=

# Base de données
DATABASE_URL=sqlite:///./prospectai.db
